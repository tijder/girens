using Gtk 4.0;
using Adw 1;

// Cover, title and buttons of an album; a row in the album and artist pages.
template $album_header : Box {
  orientation: vertical;
  spacing: 14;
  margin-top: 24;
  margin-bottom: 8;
  margin-start: 10;
  margin-end: 10;

  Box {
    spacing: 18;

    Overlay {
      valign: center;

      Image _cover_picture {
        styles [
          "album-cover",
        ]

        pixel-size: 160;
        overflow: hidden;
      }

      [overlay]
      Image _cover_placeholder {
        styles [
          "dim-label",
        ]

        icon-name: "audio-x-generic-symbolic";
        pixel-size: 48;
        halign: center;
        valign: center;
      }
    }

    Box {
      orientation: vertical;
      valign: center;
      hexpand: true;
      spacing: 4;

      Label _title_label {
        styles [
          "title-1",
        ]

        xalign: 0;
        wrap: true;
        wrap-mode: word_char;
        lines: 3;
        ellipsize: end;
      }

      // The artist, as a link; only on the page of the album itself.
      Label _artist_label {
        styles [
          "title-4",
        ]

        visible: false;
        xalign: 0;
        ellipsize: end;
      }

      // Year, number of songs and playing time.
      Label _subtitle_label {
        styles [
          "dim-label",
        ]

        xalign: 0;
        wrap: true;
      }
    }
  }

  Box {
    spacing: 8;

    Button _play_button {
      styles [
        "pill",
      ]

      child: Adw.ButtonContent {
        icon-name: "media-playback-start-symbolic";
        label: _("Play");
      };
    }

    Button _shuffle_button {
      styles [
        "circular",
      ]

      valign: center;
      icon-name: "media-playlist-shuffle-symbolic";
      tooltip-text: _("Shuffle");
    }

    MenuButton _menu_button {
      styles [
        "circular",
      ]

      valign: center;
      icon-name: "view-more-symbolic";
      tooltip-text: _("More");
    }
  }
}
