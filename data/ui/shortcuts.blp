using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "Playback");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Play/Pause");
      accelerator: "p space k";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Previous");
      accelerator: "comma";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Next");
      accelerator: "period";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Seek forwards");
      accelerator: "bracketright Right";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Seek backwards");
      accelerator: "bracketleft Left";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Volume up");
      accelerator: "Up";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Volume down");
      accelerator: "Down";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Stop playing");
      accelerator: "q";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Fullscreen");
      accelerator: "F11 f";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Fill the window with the video");
      accelerator: "t";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the controls");
      accelerator: "o";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Play musicclips instead of audio track");
      accelerator: "m";
    }
  }
}
