using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Search");
      accelerator: "<Primary>f";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Back");
      accelerator: "<Alt>Left";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Main menu");
      accelerator: "F10";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Preferences");
      accelerator: "<Primary>comma";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Keyboard shortcuts");
      accelerator: "<Primary>question";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      accelerator: "<Primary>q";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "Playback");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Play/Pause");
      accelerator: "p space k";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Previous");
      accelerator: "comma";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Next");
      accelerator: "period";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Skip intro or credits");
      accelerator: "s";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Seek forwards 10 seconds");
      accelerator: "Right";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Seek backwards 10 seconds");
      accelerator: "Left";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Seek a minute");
      accelerator: "<Shift>Left <Shift>Right";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Seek 30 seconds");
      accelerator: "bracketleft bracketright";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Previous or next chapter");
      accelerator: "Page_Up Page_Down";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Slower or faster");
      accelerator: "less greater";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Volume up");
      accelerator: "Up";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Volume down");
      accelerator: "Down";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Mute");
      accelerator: "m";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Stop playing");
      accelerator: "q";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Fullscreen");
      accelerator: "F11 f";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Fill the window with the video");
      accelerator: "t";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the controls");
      accelerator: "o";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Play musicclips instead of audio track");
      accelerator: "v";
    }
  }
}
