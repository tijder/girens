using Gtk 4.0;
using Adw 1;

template $download_row : Box {
  width-request: 200;
  height-request: 50;
  margin-start: 5;
  margin-end: 5;
  margin-top: 5;
  margin-bottom: 5;

  Overlay {
    Image _cover_image {
      styles [
        "cover_image",
      ]
      pixel-size: 50;
    }

    [overlay]
    Image _watched_image {
      styles [
        "watched_tip",
      ]

      halign: end;
      valign: start;
      margin-top: 6;
      margin-end: 6;
      width-request: 12;
      height-request: 12;
      tooltip-text: _("Unwatched");
    }
  }

  Label _title_label {
    label: "label";
    ellipsize: end;
  }

  Adw.Spinner _download_spinner {
    width-request: 25;
  }
}
