using Gtk 4.0;
using Adw 1;

Adjustment _scale_adjustment {
  upper: 1;
  step-increment: 0.01;
  page-increment: 0.01;
}

template $media_box_video_bottom : Adw.Bin {
  Revealer _revealer {
  reveal-child: true;

  Box {
    orientation: vertical;

    Box {
      margin-top: 5;

      Label _time_left_label {
        halign: start;
        valign: center;
        label: "00:00";
        margin-start: 10;
        width-chars: 7;
      }

      Scale _scale_bar {
        hexpand: true;
        adjustment: _scale_adjustment;
        restrict-to-fill-level: false;
        fill-level: 0.5;
        digits: 2;
        draw-value: false;
        value-pos: left;
      }

      Label _time_right_label {
        halign: end;
        valign: center;
        label: "99:00";
        margin-end: 10;
        width-chars: 7;
      }
    }

    Box {
      height-request: 50;
      hexpand: true;

      Overlay {
        Image _cover_image {
          pixel-size: 50;
        }

        [overlay]
        Image _watched_image {
          visible: false;
        }
      }

      MenuButton _playqueue_button {
        icon-name: "view-list-symbolic";
        tooltip-text: _("Play queue");
        width-request: 50;
        height-request: 50;
        direction: up;
      }

      Label {
        hexpand: true;
      }

      MenuButton _chapters_button {
        icon-name: "go-jump-symbolic";
        tooltip-text: _("Chapters");
        width-request: 50;
        height-request: 50;
        direction: up;
        visible: false;
      }

      MenuButton _tracks_button {
        icon-name: "media-view-subtitles-symbolic";
        tooltip-text: _("Audio and subtitles");
        width-request: 50;
        height-request: 50;
        direction: up;
      }

      ScaleButton _volume_button {
        tooltip-text: _("Volume");
        width-request: 50;
        height-request: 50;
        icons: ["audio-volume-muted-symbolic", "audio-volume-high-symbolic", "audio-volume-low-symbolic", "audio-volume-medium-symbolic"];
        adjustment: Adjustment {
          upper: 100;
          step-increment: 5;
          page-increment: 10;
        };
      }

      Box {
        Button _skip_backward_button {
          tooltip-text: _("Skip backward");
          width-request: 50;
          height-request: 50;
          Image {
            icon-name: "media-skip-backward-symbolic";
          }
        }

        Button _prev_button {
          tooltip-text: _("Previous");
          width-request: 50;
          height-request: 50;
          Image {
            icon-name: "media-seek-backward-symbolic";
          }
        }

        Button _play_button {
          tooltip-text: _("Play");
          width-request: 50;
          height-request: 50;
          Image _play_image {
            icon-name: "media-playback-start-symbolic";
          }
        }

        Button _next_button {
          tooltip-text: _("Next");
          width-request: 50;
          height-request: 50;
          Image {
            icon-name: "media-seek-forward-symbolic";
          }
        }

        Button _skip_forward_button {
          tooltip-text: _("Skip forward");
          width-request: 50;
          height-request: 50;
          Image {
            icon-name: "media-skip-forward-symbolic";
          }
        }

        styles [
          "linked",
        ]
      }

      styles [
        "media_box",
      ]
    }
  }
}
}
