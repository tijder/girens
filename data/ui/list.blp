using Gtk 4.0;
using Adw 1;

// A row (or, in grid mode, a grid) of cover tiles. The model and the item
// factory are set up in src/views/list.rs.
template $list : Adw.Bin {
  ScrolledWindow _scrolled_window {
    vscrollbar-policy: never;

    GridView _grid_view {
      max-columns: 1;
      orientation: horizontal;
    }
  }
}
