using Gtk 4.0;
using Adw 1;

template $sync_settings : Adw.Dialog {
  title: _("Sync - settings");
  content-width: 400;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesGroup {
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Adw.ActionRow {
        title: _("Convert");
        tooltip-text: _("Converted sync can take a long time");
        use-underline: true;
        activatable-widget: _convert_button;

        Switch _convert_button {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Unwatched only");
        use-underline: true;
        activatable-widget: _unwatched_button;

        Switch _unwatched_button {
          valign: center;
        }
      }

      Adw.EntryRow _max_items_entry {
        title: _("Max items");
        input-purpose: number;
        use-underline: true;
      }

      Button _sync_button {
        tooltip-text: _("Sync");
        label: _("Sync");
        margin-top: 12;

        styles ["suggested-action"]
      }
    };
  };
}
