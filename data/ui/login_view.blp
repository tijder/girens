using Gtk 4.0;
using Adw 1;

template $login_view : Box {
  orientation: vertical;

  Adw.HeaderBar {
    [start]
    Button _cancel_button {
      label: _("Cancel");
      visible: false;
    }
  }

  Adw.Banner _error_banner {}

  ScrolledWindow {
    vexpand: true;
    hscrollbar-policy: never;

    Adw.Clamp {
      maximum-size: 500;
      margin-start: 12;
      margin-end: 12;
      margin-top: 24;
      margin-bottom: 24;

      Box {
        orientation: vertical;
        spacing: 24;

        Label _title_label {
          label: _("Sign in");
          styles [
            "title-1",
          ]
        }

        Adw.PreferencesGroup {
          title: _("Plex");

          Adw.ActionRow {
            title: _("Sign in on plex.tv");
            subtitle: _("Opens your browser; also for accounts with two-factor authentication");
            activatable-widget: _browser_button;

            Button _browser_button {
              valign: center;
              label: _("Sign in");

              styles [
                "suggested-action",
              ]
            }
          }

          Adw.ExpanderRow {
            title: _("Username and password");

            Adw.EntryRow _username_entry {
              title: _("Username");
              input-purpose: name;
            }

            Adw.PasswordEntryRow _password_entry {
              title: _("Password");
            }

            Adw.EntryRow _code_entry {
              title: _("Verification code, for two-factor authentication");
              input-purpose: digits;
            }

            Adw.ActionRow {
              activatable-widget: _connect_user_button;

              [suffix]
              Button _connect_user_button {
                valign: center;
                label: _("Sign in");
                sensitive: false;
              }
            }
          }

          Adw.ExpanderRow {
            title: _("Server address and token");
            subtitle: _("Without a plex.tv account");

            Adw.EntryRow _server_url_entry {
              title: _("The URL to the Plex server with the port number");
              input-purpose: url;
            }

            Adw.EntryRow _server_token_entry {
              title: _("Token");
            }

            Adw.ActionRow {
              activatable-widget: _connect_url_button;

              [suffix]
              Button _connect_url_button {
                valign: center;
                label: _("Connect");
                sensitive: false;
              }
            }
          }
        }

        Adw.PreferencesGroup {
          title: _("Ister");

          Adw.EntryRow _ister_address_entry {
            title: _("The address of the Ister server");
            input-purpose: url;
          }

          Adw.ActionRow _ister_row {
            title: _("Sign in to an Ister server");
            subtitle: _("Opens your browser to sign in");
            activatable-widget: _connect_ister_button;

            Button _connect_ister_button {
              valign: center;
              label: _("Sign in");
              sensitive: false;

              styles [
                "suggested-action",
              ]
            }
          }
        }
      }
    }
  }
}
