using Gtk 4.0;
using Adw 1;

template $media_box_video_top : Adw.Bin {
  Revealer _revealer {
  Box {
    height-request: 50;

    Box {
      Button _fullscreen_button {
        tooltip-text: _("Fullscreen");
        width-request: 50;
        height-request: 50;
        Image {
          icon-name: "view-fullscreen-symbolic";
        }
      }
      Button _fullscreen_windowed_button {
        tooltip-text: _("Fill window");
        width-request: 50;
        height-request: 50;
        Image {
          icon-name: "video-display-symbolic";
        }
      }
      styles [
        "linked",
      ]
    }

    Box {
      orientation: vertical;
      Label _title_label {
        margin-top: 5;
        hexpand: true;
        label: "Title";
        ellipsize: end;
      }
      Label _subtitle_label {
        margin-bottom: 5;
        label: "subtitle";
        ellipsize: end;
      }
    }
    Button _close_button {
      tooltip-text: _("Stop");
      width-request: 50;
      height-request: 50;
      Image {
        icon-name: "media-playback-stop-symbolic";
      }
    }
    styles [
      "media_box",
    ]
  }
}
}
