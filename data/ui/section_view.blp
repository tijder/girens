using Gtk 4.0;
using Adw 1;

template $section_view : Adw.Bin {
  vexpand: true;

  Overlay {
    Box {
      orientation: vertical;

      // The header bar names the page; this label only keeps the name for it.
      Label _title_label {
        visible: false;
      }

      Box {
        Box _section_controll_box {
          margin-top: 8;
          margin-bottom: 6;
          margin-end: 10;
          halign: end;
          hexpand: true;

          Button _play_button {
            tooltip-text: _("Play");
            Image {
              icon-name: "media-playback-start-symbolic";
            }
          }

          Button _shuffle_button {
            tooltip-text: _("Shuffle");
            Image {
              icon-name: "media-playlist-shuffle-symbolic";
            }
          }

          DropDown _filter_box {}

          Button _order_button {
            tooltip-text: _("Order");

            Image _order_image {
              icon-name: "view-sort-ascending-symbolic";
            }
          }

          styles [
            "linked",
          ]
        }
      }

      $list _section_flow {}
    }

    [overlay]
    Box _load_box {
      styles [
        "load-box"
      ]
      vexpand: true;
      hexpand: true;
      opacity: 0.8;
      visible: true;
      Adw.Spinner _load_spinner {
        height-request: 75;
        width-request: 75;
        halign: center;
        valign: center;
        vexpand: true;
        hexpand: true;
        visible: true;
      }
    }
  }
}
