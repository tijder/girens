using Gtk 4.0;
using Adw 1;

template $loading_view : Box {
  orientation: vertical;

  Adw.HeaderBar {}

  Box {
    halign: center;
    valign: center;
    hexpand: true;
    vexpand: true;
    orientation: vertical;

    Adw.Spinner _spinner {
      height-request: 50;
      width-request: 50;
    }

    Label _loading_text_label {
      label: "Loading text";
      margin-top: 10;
      wrap: true;
      justify: center;
      max-width-chars: 40;
    }

    Gtk.Button _action_button {
      visible: false;
      margin-top: 20;

      styles [
        "suggested-action",
      ]
    }

    Box _waiting_box {
      visible: false;
      orientation: vertical;
      spacing: 10;
      margin-top: 20;

      Label _code_hint_label {
        visible: false;
        wrap: true;
        justify: center;
        max-width-chars: 40;

        styles [
          "dim-label",
        ]
      }

      Label _code_label {
        visible: false;
        use-markup: true;
        margin-bottom: 10;

        styles [
          "title-1",
        ]
      }

      Gtk.Button _open_button {
        label: _("Open the page again");
      }

      Gtk.Button _copy_button {
        label: _("Copy the link");
      }

      Gtk.Button _cancel_button {
        label: _("Cancel");
      }
    }

    Gtk.Button _logout_button {
      label: _("Sign out");
      margin-top: 20;
    }

    Gtk.Button _accounts_button {
      label: _("Accounts");
      margin-top: 10;
      visible: false;
    }
  }
}
