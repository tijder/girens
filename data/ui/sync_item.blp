using Gtk 4.0;

template $sync_item : Box {
  spacing: 12;
  margin-top: 8;
  margin-bottom: 8;
  margin-start: 8;
  margin-end: 8;

  Overlay {
    Image _cover_image {
      styles [
        "cover_image",
        "album-cover",
      ]
      overflow: hidden;
      pixel-size: 64;
    }

    [overlay]
    Image _watched_image {
      styles [
        "watched_tip",
      ]

      halign: end;
      valign: start;
      margin-top: 8;
      margin-end: 8;
      pixel-size: 8;
      tooltip-text: _("Unwatched");
    }
  }

  Label _title_label {
    label: "label";
    xalign: 0;
    ellipsize: end;
    hexpand: true;
  }

  Button _remove_button {
    styles [
      "flat",
      "circular",
    ]

    valign: center;
    tooltip-text: _("Remove");
    icon-name: "edit-delete-symbolic";
  }
}
