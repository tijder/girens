using Gtk 4.0;

template $sync_item : Box {
  height-request: 50;
  Overlay {
    Image _cover_image {
      styles [
        "cover_image",
      ]
      pixel-size: 100;
    }

    [overlay]
    Image _watched_image {
      styles [
        "watched_tip",
      ]

      halign: end;
      valign: start;
      margin-top: 6;
      margin-end: 6;
      width-request: 12;
      height-request: 12;
      tooltip-text: _("Unwatched");
    }
  }

  Label _title_label {
    margin-start: 5;
    margin-end: 5;
    label: "label";
    ellipsize: end;
    hexpand: true;
  }

  Button _remove_button {
    tooltip-text: _("Remove");
    width-request: 50;
    Image {
      icon-name: "edit-delete-symbolic";
    }
  }
}
