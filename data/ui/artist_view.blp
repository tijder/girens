using Gtk 4.0;
using Adw 1;

// One virtualised list: the artist (`_header`, below), then every album
// with its tracks.
template $artist_view : Adw.Bin {
  ScrolledWindow _scrolled_window {
    hscrollbar-policy: never;
    vexpand: true;

    Adw.ClampScrollable {
      maximum-size: 800;

      ListView _list_view {
        single-click-activate: true;

        styles [
          "page-list",
        ]
      }
    }
  }
}

Box _header {
  orientation: horizontal;
  margin-top: 20;
  margin-bottom: 10;
  margin-start: 10;
  margin-end: 10;

  Box {
    orientation: vertical;

    Label _title_label {
      styles [
        "title-1",
      ]

      halign: start;
      label: "label";
      ellipsize: end;
    }

    Label _subtitle_label {
      halign: start;
      label: "label";
      ellipsize: end;
    }
  }

  Box _section_controll_box {
    hexpand: true;
    halign: end;
    valign: center;

    styles [
      "linked",
    ]

    Button _play_button {
      Image {
        icon-name: "media-playback-start-symbolic";
      }
    }

    Button _shuffle_button {
      Image {
        icon-name: "media-playlist-shuffle-symbolic";
      }
    }
  }
}
