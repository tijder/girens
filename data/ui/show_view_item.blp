using Gtk 4.0;

template $show_view_item : Box {
  spacing: 14;
  margin-top: 6;
  margin-bottom: 6;
  margin-start: 4;
  margin-end: 4;

  Overlay {
    halign: center;
    valign: center;
    overflow: hidden;

    styles [
      "album-cover",
    ]

    Picture _cover_image {
      styles [
        "cover_image",
      ]

      height-request: 90;
      width-request: 160;
      valign: center;
      halign: center;
      content-fit: cover;
    }

    [overlay]
    Image _watched_image {
      styles [
        "watched_tip",
      ]

      halign: end;
      valign: start;
      margin-top: 6;
      margin-end: 6;
      width-request: 12;
      height-request: 12;
      tooltip-text: _("Unwatched");
    }

    [overlay]
    ProgressBar _progress_bar {
      valign: end;
    }
  }

  Box {
    orientation: vertical;
    hexpand: true;
    valign: center;
    spacing: 2;

    Label _title_label {
      styles [
        "heading",
      ]

      label: "title label";
      xalign: 0;
      ellipsize: end;
    }

    Label _release_label {
      styles [
        "caption",
        "dim-label",
      ]

      label: "release label";
      xalign: 0;
      ellipsize: end;
    }

    Label _description_label {
      styles [
        "dim-label",
      ]

      label: "description label";
      xalign: 0;
      lines: 2;
      ellipsize: end;
      wrap: true;
    }
  }
}
