using Gtk 4.0;
using Adw 1;

// The page is one virtualised list: the details of the show are its first
// row (`_header`, below), the episodes of the chosen season follow.
template $show_view : Adw.Bin {
  ScrolledWindow _scrolled_window {
    hscrollbar-policy: never;
    vexpand: true;

    Adw.ClampScrollable {
      maximum-size: 800;

      ListView _list_view {
        single-click-activate: true;

        styles [
          "page-list",
        ]
      }
    }
  }
}

Box _header {
  orientation: vertical;

  Box {
    orientation: vertical;
    spacing: 14;
    margin-top: 24;
    margin-bottom: 14;
    margin-start: 10;
    margin-end: 10;

    Box {
      spacing: 18;

      Picture _cover_image {
        styles [
          "cover_image",
          "album-cover",
        ]

        height-request: 220;
        width-request: 150;
        halign: start;
        valign: start;
        content-fit: cover;
        overflow: hidden;
      }

      Box {
        orientation: vertical;
        valign: center;
        hexpand: true;
        spacing: 4;

        Label _title_label {
          styles [
            "title-1",
          ]

          xalign: 0;
          wrap: true;
          wrap-mode: word_char;
          lines: 2;
          ellipsize: end;
        }

        // Year, number of seasons and episodes.
        Label _subtitle_label {
          styles [
            "dim-label",
          ]

          xalign: 0;
          wrap: true;
        }

        Label _description_label {
          margin-top: 6;
          xalign: 0;
          lines: 6;
          ellipsize: end;
          wrap: true;
        }
      }
    }

    Box _section_controll_box {
      spacing: 8;

      Button _play_button {
        styles [
          "pill",
          "suggested-action",
        ]

        child: Adw.ButtonContent {
          icon-name: "media-playback-start-symbolic";
          label: _("Play");
        };
      }

      Button _shuffle_button {
        styles [
          "pill",
        ]

        child: Adw.ButtonContent {
          icon-name: "media-playlist-shuffle-symbolic";
          label: _("Shuffle");
        };
      }
    }
  }

  ScrolledWindow _season_scrolled_window {
    vscrollbar-policy: never;
    margin-start: 10;
    margin-end: 10;
    margin-bottom: 10;

    Box _season_box {
      styles [
        "linked",
      ]
    }
  }
}
