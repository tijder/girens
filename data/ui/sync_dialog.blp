using Gtk 4.0;
using Adw 1;

template $sync_dialog : Adw.Dialog {
  title: _("Sync items");
  content-width: 400;
  content-height: 400;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      ListBox _item_box {
        selection-mode: none;
        activate-on-single-click: false;
        valign: start;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;

        styles ["boxed-list"]
      }
    };

    [bottom]
    Button _sync_button {
      tooltip-text: _("Sync");
      label: _("Sync");
      halign: center;
      margin-top: 6;
      margin-bottom: 12;

      styles ["suggested-action", "pill"]
    }
  };
}
