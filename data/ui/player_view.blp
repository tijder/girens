using Gtk 4.0;
using Adw 1;

template $player_view : Adw.Bin {
  ScrolledWindow _scrolled_window {
  vexpand: true;
  hscrollbar-policy: never;
  EventControllerKey _key_controller {}
  Box {
    vexpand: true;
    orientation: vertical;
    Gtk.Box _video_box {
      height-request: 500;

      EventControllerMotion _motion_controller {}

      Overlay _overlay {
        Stack _stack {
          GestureClick _click {
            button: 1;
            exclusive: true;
          }

          GestureClick _right_click {
            button: 3;
            exclusive: true;
          }

          GLArea _frame {
            hexpand: true;
          }
        }

        [overlay]
        Gtk.WindowHandle {
          valign: start;
          Box _controlls_top {
            valign: start;
            opacity: 0.8;

            styles [
              "media_box",
            ]
            $media_box_video_top _media_top {
              hexpand: true;
            }
          }
        }

        [overlay]
        Button _skip_button {
          visible: false;
          halign: end;
          valign: end;
          margin-end: 24;
          margin-bottom: 96;

          styles [
            "osd",
            "pill",
          ]
        }

        [overlay]
        Box _controlls_bottom {
          valign: end;
          opacity: 0.8;

          styles [
            "media_box",
          ]
          $media_box_video_bottom _media_bottom {
            hexpand: true;
          }
        }
      }
    }

    Revealer _revealer {
      reveal-child: true;
      transition-type: slide_up;
      Box _box {
        orientation: vertical;
        margin-start: 10;
        margin-end: 10;
        Box _card_box {
          margin-top: 10;
          margin-bottom: 5;
          orientation: horizontal;
          spacing: 12;

          ListBox {
            styles["boxed-list"]
            selection-mode: none;
            hexpand: true;
            valign: start;

            // The name of a detail above its value.
            Adw.ActionRow _title_label {
              styles["property"]
              title: _("Title");
              use-markup: false;
            }
            Adw.ActionRow _release_datum_label {
              styles["property"]
              title: _("Release date");
              use-markup: false;
            }
            Adw.ActionRow _genre_label {
              styles["property"]
              title: _("Genre");
              use-markup: false;
            }
            Adw.ActionRow _duration_label {
              styles["property"]
              title: _("Duration");
              use-markup: false;
            }
            Adw.ActionRow _discription_label {
              styles["property"]
              title: _("Description");
              subtitle-lines: 100;
              use-markup: false;
            }
          }

          ListBox _options_list {
            styles["boxed-list"]
            selection-mode: none;
            width-request: 300;
            valign: start;

            Adw.ComboRow _audio_box {
              title: _("Audio ");
            }
            Adw.ComboRow _subtitle_box {
              title: _("Subtitle ");
            }
          }
        }

        Label _label {
          styles [
            "title-3"
          ]
          halign: start;
          margin-top: 20;
          margin-bottom: 5;
          label: _("Continue watching");
        }

        $list _deck_shows_box {}
      }
    }
  }
}
}
