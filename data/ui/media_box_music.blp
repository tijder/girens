using Gtk 4.0;
using Adw 1;

Adjustment _scale_adjustment {
  upper: 1;
  step-increment: 0.01;
  page-increment: 0.01;
}

template $media_box_music : Adw.Bin {
  Revealer _revealer {
  reveal-child: true;
  Grid {
    Box {
      margin-top: 5;

      Label _time_left_label {
        halign: start;
        valign: center;
        label: "00:00";
        margin-start: 10;
        width-chars: 7;
      }

      Scale _scale_bar {
        hexpand: true;
        adjustment: _scale_adjustment;
        restrict-to-fill-level: false;
        fill-level: 0.5;
        digits: 2;
        draw-value: false;
        value-pos: left;
      }

      Label _time_right_label {
        halign: end;
        valign: center;
        label: "99:00";
        margin-end: 10;
        width-chars: 7;
      }

      layout {
        row: 0;
        column: 0;
      }
    }

    Box _label2_box {
      halign: center;
      hexpand: true;
      orientation: vertical;
      layout {
        row: 1;
        column: 0;
      }
    }

    Grid {
      height-request: 50;
      margin-top: 5;
      hexpand: true;

      Overlay {
        Image _cover_image {
          pixel-size: 50;
        }

        [overlay]
        Image _watched_image {
          visible: false;
        }
      }

      MenuButton _playqueue_button {
        icon-name: "view-list-symbolic";
        tooltip-text: _("Play queue");
        width-request: 50;
        height-request: 50;
        direction: up;
      }

      Box _label_box {
        halign: center;
        hexpand: true;
        orientation: vertical;

        Label _title_label {
          label: "Title";
          ellipsize: end;
        }

        Label _subtitle_label {
          label: "subtitle";
          ellipsize: end;
        }
      }

      Box {
        Button _prev_button {
          tooltip-text: _("Previous");
          width-request: 50;
          height-request: 50;

          Image {
            icon-name: "media-seek-backward-symbolic";
          }
        }

        Button _play_button {
          tooltip-text: _("Play");
          width-request: 50;
          height-request: 50;
          Image _play_image {
            icon-name: "media-playback-start-symbolic";
          }
        }

        Button _next_button {
          tooltip-text: _("Next");
          width-request: 50;
          height-request: 50;
          Image {
            icon-name: "media-seek-forward-symbolic";
          }
        }

        Button _close_button {
          tooltip-text: _("Stop");
          width-request: 50;
          height-request: 50;
          receives-default: true;

          Image {
            icon-name: "media-playback-stop-symbolic";
          }
        }

        ScaleButton _volume_button {
          tooltip-text: _("Volume");
          icons: ["audio-volume-muted-symbolic", "audio-volume-high-symbolic", "audio-volume-low-symbolic", "audio-volume-medium-symbolic"];
          adjustment: Adjustment {
            upper: 100;
            step-increment: 5;
            page-increment: 10;
          };
        }

        MenuButton _media_settings {
          icon-name: "view-more-symbolic";
          tooltip-text: _("Options");
          width-request: 50;
          height-request: 50;
          direction: up;
        }

        styles [
          "linked",
        ]
      }

      layout {
        row: 2;
        column: 0;
      }
    }

    styles [
      "media_box",
    ]
  }
}
}
