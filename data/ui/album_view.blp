using Gtk 4.0;
using Adw 1;

// One virtualised list: the album header followed by its tracks.
template $album_view : Adw.Bin {
  ScrolledWindow _scrolled_window {
    hscrollbar-policy: never;
    vexpand: true;

    Adw.ClampScrollable {
      maximum-size: 800;

      ListView _list_view {
        single-click-activate: true;

        styles [
          "page-list",
        ]
      }
    }
  }
}
